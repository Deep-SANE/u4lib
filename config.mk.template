#EIGEN_DIR=
#WIGXJPF_DIR=
#U3LIB_DIR=

CXX = g++

# include (if needed):
INC += -I$(EIGEN_DIR)
INC += -I$(WIGXJPF_DIR)/inc
INC += -I$(U3LIB_DIR)/include

CXXFLAGS += -std=c++17
CXXFLAGS += $(INC)

# optimization / debugging options:
CXXFLAGS += -O3 
CXXFLAGS += -DNDEBUG 
#CXXFLAGS += -O0 
#CXXFLAGS += -g 
#CXXFLAGS += -fsanitize=address

LDFLAGS += -L$(WIGXJPF_DIR)/lib -lwigxjpf

