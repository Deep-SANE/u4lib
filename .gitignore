# Generated configuration (written by `make config`)
config/config.generated.mk

# Build outputs
bin/
python/u4lib.so
python/u4lib.d
*.o

# Compiler dependency files (except make.d directories)
*.d
!config/make.d/
!config/make.d/**

# TeX build artifacts (keep doc/Manual.pdf)
doc/*.aux
doc/*.log
doc/*.out
doc/*.bbl
doc/*.blg
doc/*.fls
doc/*.fdb_latexmk

# Benchmark reproduction artifacts (keep results.{csv,json} + runner scripts).
# Per-run agent workspaces and frozen snapshots are large and machine-specific.
agents/benchmarks/*/task*-*/
agents/benchmarks/*/schedule*.json
agents/benchmarks/snapshots/

# macOS / editor / notebook cruft
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints
.gdb_history
*.swp
